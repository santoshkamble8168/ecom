NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

DATABASE_URL=postgresql://ecom:ecom@localhost:5432/ecom?schema=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_REFRESH_TTL=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=ecomminio
MINIO_SECRET_KEY=ecomminio123
MINIO_BUCKET=ecom-assets

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Checkout session (Sprint 7)
CHECKOUT_TTL_MINUTES=30
CHECKOUT_IDEMPOTENCY_TTL_HOURS=24

# Payments (Sprint 8)
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_EXPIRY_MINUTES=30
PAYMENT_MAX_RETRIES=3
COD_MAX_ORDER_VALUE=15000

LOG_LEVEL=info

# Sprint 12 — admin dashboard / exports / audit / feature flags
EXPORT_STORAGE_PATH=./tmp/exports
REPORT_RETENTION_DAYS=14
DASHBOARD_CACHE_TTL_SECONDS=60
AUDIT_RETENTION_DAYS=365
FEATURE_FLAG_CACHE_TTL_SECONDS=30

# Sprint 13 — notifications (Mailpit locally: SMTP_HOST=localhost SMTP_PORT=1025)
SMTP_FROM=ECOM <noreply@ecom.local>
SMS_PROVIDER=mock
NOTIFICATION_QUEUE_CONCURRENCY=5
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_MS=2000
NOTIFICATION_DLQ_RETENTION_DAYS=14
UNSUBSCRIBE_URL=http://localhost:3000/account
NOTIFICATION_OPS_EMAIL=ops@ecom.local

# Sprint 14 — analytics
ANALYTICS_ENABLED=true
ANALYTICS_SAMPLE_RATE=1
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_DEBUG=false

# Sprint 16 — recommendations (rule-based MVP; AI/semantic flags stay off)
RECOMMENDATION_CACHE_TTL_SECONDS=60
PERSONALIZATION_RETENTION_DAYS=90
SEMANTIC_SEARCH_PROVIDER=none

# Fixed OTP for seeded demo accounts in development (see prisma/seed.ts)
DEV_DEMO_OTP=123456

# CMS (Sprint 11) — token required to preview draft/scheduled/archived pages
# via GET /cms/pages/:slug/preview?token=... . Not part of the strict env
# schema (apps/api reads it directly with a safe dev fallback).
CMS_PREVIEW_TOKEN=dev-preview-token
