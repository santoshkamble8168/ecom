// Sprint 0 baseline schema: identity, platform, and audit domains only.
// Catalog, inventory, cart, checkout, orders, payments, etc. are added in
// their respective sprints per documents/sprint-planning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity domain
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
  pending_verification
}

model User {
  id           String     @id @default(uuid())
  email        String?    @unique
  phone        String?    @unique
  displayName  String?    @map("display_name")
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(pending_verification)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles            UserRole[]
  refreshTokens    RefreshToken[]
  oauthAccounts    OAuthAccount[]
  auditLogs        AuditLog[]
  profile          CustomerProfile?
  addresses        Address[]
  reviews          ProductReview[]
  wishlistItems    WishlistItem[]
  recentlyViewed   RecentlyViewed[]
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
  payments         Payment[]
  returnRequests   ReturnRequest[]
  exchangeRequests ExchangeRequest[]
  referralCode     ReferralCode?
  loyaltyAccount   LoyaltyAccount?
  supportNotes     CustomerSupportNote[] @relation("CustomerNotes")
  authoredNotes    CustomerSupportNote[] @relation("NoteAuthor")
  exportJobs       ExportJob[]
  savedViews       SavedView[]
  notificationPreference NotificationPreference?
  deliveryLogs     DeliveryLog[]
  analyticsEvents  AnalyticsEvent[]
  personalizationProfile PersonalizationProfile?

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum OtpChannel {
  email
  sms
}

model OtpChallenge {
  id          String     @id @default(uuid())
  channel     OtpChannel
  destination String
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  consumedAt  DateTime?  @map("consumed_at")
  expiresAt   DateTime   @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([destination, channel])
  @@map("otp_challenges")
}

enum OAuthProvider {
  google
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CustomerProfile {
  userId      String   @id @map("user_id")
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Address {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  label      String?
  fullName   String   @map("full_name")
  phone      String
  line1      String   @map("line1")
  line2      String?  @map("line2")
  city       String
  state      String
  postalCode String   @map("postal_code")
  country    String   @default("IN")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Platform domain
// ---------------------------------------------------------------------------

model FeatureFlag {
  id              String   @id @default(uuid())
  key             String   @unique
  isEnabled       Boolean  @default(false) @map("is_enabled")
  description     String?
  /// `all` applies everywhere; otherwise matches `NODE_ENV`.
  environment     String   @default("all")
  rolloutPercent  Int      @default(100) @map("rollout_percent")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([environment, isEnabled])
  @@map("feature_flags")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Audit domain
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  requestId  String?  @map("request_id")
  ipAddress  String?  @map("ip_address")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog domain (Sprint 2)
// ---------------------------------------------------------------------------

enum ProductStatus {
  draft
  review
  published
  archived
}

enum MediaType {
  image
  video
}

enum AttributeType {
  select
  text
  number
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  ancestors   CategoryClosure[] @relation("Descendant")
  descendants CategoryClosure[] @relation("Ancestor")
  products    ProductCategory[]
  taxRules    TaxRule[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model CategoryClosure {
  ancestorId   String @map("ancestor_id")
  descendantId String @map("descendant_id")
  depth        Int

  ancestor   Category @relation("Ancestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Category @relation("Descendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("category_closure")
}

model AttributeDefinition {
  id        String        @id @default(uuid())
  key       String        @unique
  name      String
  type      AttributeType @default(select)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")

  values AttributeValue[]

  @@map("attribute_definitions")
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String @map("attribute_id")
  value       String
  slug        String
  sortOrder   Int    @default(0) @map("sort_order")

  attribute      AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantOptions VariantOption[]

  @@unique([attributeId, slug])
  @@map("attribute_values")
}

model Tag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  products ProductTag[]

  @@map("tags")
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products  ProductCollection[]
  campaigns CampaignCollection[]

  @@index([slug])
  @@index([isActive])
  @@map("collections")
}

model Product {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  description    String?
  brand          String?
  status         ProductStatus @default(draft)
  basePrice      Decimal?      @map("base_price") @db.Decimal(10, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(10, 2)
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  variants    ProductVariant[]
  media       ProductMedia[]
  seo         ProductSeo?
  categories  ProductCategory[]
  collections ProductCollection[]
  tags        ProductTag[]
  reviews     ProductReview[]

  @@index([status])
  @@index([slug])
  @@index([updatedAt])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  sku            String   @unique
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options VariantOption[]

  @@index([productId])
  @@map("product_variants")
}

model VariantOption {
  variantId        String @map("variant_id")
  attributeValueId String @map("attribute_value_id")

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@map("variant_options")
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  url       String
  altText   String?   @map("alt_text")
  type      MediaType @default(image)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductSeo {
  productId       String  @id @map("product_id")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  metaKeywords    String? @map("meta_keywords")
  canonicalUrl    String? @map("canonical_url")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_seo")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductCollection {
  productId    String @map("product_id")
  collectionId String @map("collection_id")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model ProductTag {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// ---------------------------------------------------------------------------
// Storefront / CMS domain (Sprint 3)
// ---------------------------------------------------------------------------

enum NavigationLocation {
  header
  footer_shop
  footer_support
  footer_legal
}

model AnnouncementBar {
  id        String   @id @default(uuid())
  message   String
  linkUrl   String?  @map("link_url")
  linkLabel String?  @map("link_label")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("announcement_bars")
}

model HomepageBlock {
  id        String   @id @default(uuid())
  key       String   @unique
  type      String
  title     String?
  content   Json
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("homepage_blocks")
}

model NavigationItem {
  id        String             @id @default(uuid())
  label     String
  href      String
  parentId  String?            @map("parent_id")
  location  NavigationLocation
  sortOrder Int                @default(0) @map("sort_order")
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at")

  parent   NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("NavTree")

  @@index([location, isActive, sortOrder])
  @@map("navigation_items")
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletter_subscribers")
}

model TrendingSearch {
  id        String  @id @default(uuid())
  term      String  @unique
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@index([isActive, sortOrder])
  @@map("trending_searches")
}

// ---------------------------------------------------------------------------
// Discovery domain (Sprint 4)
// ---------------------------------------------------------------------------

model SearchLog {
  id          String   @id @default(uuid())
  query       String
  resultCount Int      @map("result_count")
  filters     Json?
  source      String   @default("search")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([query])
  @@index([createdAt])
  @@map("search_logs")
}

// ---------------------------------------------------------------------------
// Product detail domain (Sprint 5)
// ---------------------------------------------------------------------------

enum ReviewStatus {
  pending
  published
  rejected
}

model ProductReview {
  id                 String       @id @default(uuid())
  productId          String       @map("product_id")
  userId             String?      @map("user_id")
  rating             Int
  title              String?
  body               String?
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  status             ReviewStatus @default(published)
  createdAt          DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([rating])
  @@map("product_reviews")
}

model WishlistItem {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  sessionId   String?  @map("session_id")
  productSlug String   @map("product_slug")
  variantSku  String?  @map("variant_sku")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productSlug])
  @@unique([sessionId, productSlug])
  @@index([userId])
  @@index([sessionId])
  @@map("wishlist_items")
}

model RecentlyViewed {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  sessionId   String?  @map("session_id")
  productSlug String   @map("product_slug")
  viewedAt    DateTime @default(now()) @map("viewed_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
  @@map("recently_viewed")
}

// ---------------------------------------------------------------------------
// Cart domain (Sprint 6)
// ---------------------------------------------------------------------------

enum CouponType {
  percent
  fixed
  free_shipping
}

model Coupon {
  id                    String     @id @default(uuid())
  code                  String     @unique
  description           String?
  type                  CouponType
  value                 Decimal    @db.Decimal(10, 2)
  minCartValue          Decimal?   @map("min_cart_value") @db.Decimal(10, 2)
  maxUses               Int?       @map("max_uses")
  usedCount             Int        @default(0) @map("used_count")
  /// Max times a single customer may use this coupon; null = unlimited.
  perUserLimit          Int?       @map("per_user_limit")
  /// Whether this coupon can be stacked with other active coupons on the same cart.
  combinable            Boolean    @default(false)
  /// Empty array = no category restriction (applies sitewide).
  eligibleCategoryIds   String[]   @default([]) @map("eligible_category_ids")
  /// Empty array = no collection restriction (applies sitewide).
  eligibleCollectionIds String[]   @default([]) @map("eligible_collection_ids")
  expiresAt             DateTime?  @map("expires_at")
  isActive              Boolean    @default(true) @map("is_active")
  createdAt             DateTime   @default(now()) @map("created_at")

  usages CouponUsage[]

  @@map("coupons")
}

/// Append-only record of every successful coupon redemption, for per-user
/// limit enforcement and marketing reporting. Never updated or deleted.
model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  userId         String?  @map("user_id")
  sessionId      String?  @map("session_id")
  orderId        String?  @map("order_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  usedAt         DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

model Cart {
  id        String    @id @default(uuid())
  userId    String?   @unique @map("user_id")
  sessionId String?   @unique @map("session_id")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  coupons   CartCoupon[]
  checkouts CheckoutSession[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String   @map("cart_id")
  productSlug   String   @map("product_slug")
  variantSku    String   @map("variant_sku")
  quantity      Int      @default(1)
  savedForLater Boolean  @default(false) @map("saved_for_later")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantSku, savedForLater])
  @@index([cartId])
  @@map("cart_items")
}

model CartCoupon {
  cartId         String  @map("cart_id")
  code           String
  discountAmount Decimal @map("discount_amount") @db.Decimal(10, 2)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@id([cartId, code])
  @@map("cart_coupons")
}

// ---------------------------------------------------------------------------
// Checkout domain (Sprint 7)
// ---------------------------------------------------------------------------

enum CheckoutStatus {
  draft
  address_selected
  shipping_selected
  payment_selected
  reviewed
  order_prepared
  expired
  cancelled
}

enum CheckoutPaymentMethod {
  razorpay
  cod
}

model CheckoutSession {
  id                 String                 @id @default(uuid())
  cartId             String                 @map("cart_id")
  userId             String?                @map("user_id")
  sessionId          String?                @map("session_id")
  status             CheckoutStatus         @default(draft)
  subtotal           Decimal                @db.Decimal(10, 2)
  discount           Decimal                @db.Decimal(10, 2)
  shippingFee        Decimal                @map("shipping_fee") @db.Decimal(10, 2)
  taxAmount          Decimal                @map("tax_amount") @db.Decimal(10, 2)
  total              Decimal                @db.Decimal(10, 2)
  addressId          String?                @map("address_id")
  guestAddress       Json?                  @map("guest_address")
  shippingMethodCode String?                @map("shipping_method_code")
  shippingLabel      String?                @map("shipping_label")
  estimatedDaysMin   Int?                   @map("estimated_days_min")
  estimatedDaysMax   Int?                   @map("estimated_days_max")
  paymentMethod      CheckoutPaymentMethod? @map("payment_method")
  lineItemsSnapshot  Json                   @map("line_items_snapshot")
  couponsSnapshot    Json                   @map("coupons_snapshot")
  reviewValidAt      DateTime?              @map("review_valid_at")
  preparedOrderRef   String?                @unique @map("prepared_order_ref")
  expiresAt          DateTime               @map("expires_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  cart            Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  idempotencyKeys CheckoutIdempotency[]
  payments        Payment[]
  order           Order?

  @@index([userId])
  @@index([sessionId])
  @@index([cartId])
  @@index([status])
  @@index([expiresAt])
  @@map("checkout_sessions")
}

model CheckoutIdempotency {
  id             String   @id @default(uuid())
  checkoutId     String   @map("checkout_id")
  idempotencyKey String   @map("idempotency_key")
  response       Json
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  checkout CheckoutSession @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@unique([checkoutId, idempotencyKey])
  @@index([expiresAt])
  @@map("checkout_idempotency")
}

model ShippingMethod {
  id               String   @id @default(uuid())
  code             String   @unique
  label            String
  baseFee          Decimal  @map("base_fee") @db.Decimal(10, 2)
  estimatedDaysMin Int      @map("estimated_days_min")
  estimatedDaysMax Int      @map("estimated_days_max")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  zones ShippingZone[]

  @@map("shipping_methods")
}

model ShippingZone {
  id               String   @id @default(uuid())
  name             String
  pincodePrefixes  String[] @map("pincode_prefixes")
  shippingMethodId String   @map("shipping_method_id")
  feeOverride      Decimal? @map("fee_override") @db.Decimal(10, 2)
  isServiceable    Boolean  @default(true) @map("is_serviceable")
  createdAt        DateTime @default(now()) @map("created_at")

  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  @@index([shippingMethodId])
  @@map("shipping_zones")
}

model TaxRule {
  id         String   @id @default(uuid())
  name       String
  rate       Decimal  @db.Decimal(5, 4)
  appliesTo  String   @default("all") @map("applies_to")
  /// Optional category scope; null means the rule applies regardless of category
  /// (subject to `appliesTo` and `priority`).
  categoryId String?  @map("category_id")
  isActive   Boolean  @default(true) @map("is_active")
  priority   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([isActive])
  @@map("tax_rules")
}

// ---------------------------------------------------------------------------
// Payments + minimal Order (Sprint 8; Orders expanded in Sprint 9)
// ---------------------------------------------------------------------------

enum OrderStatus {
  pending_payment
  confirmed
  processing
  shipped
  delivered
  return_requested
  returned
  exchange_requested
  exchanged
  cancelled
  failed
}

enum OrderActorType {
  customer
  admin
  system
}

enum PaymentStatus {
  created
  pending
  authorized
  captured
  failed
  cancelled
  refunded
}

enum PaymentProvider {
  razorpay
  cod
}

model Order {
  id              String                @id @default(uuid())
  orderNumber     String                @unique @map("order_number")
  checkoutId      String                @unique @map("checkout_id")
  userId          String?               @map("user_id")
  sessionId       String?               @map("session_id")
  status          OrderStatus           @default(pending_payment)
  subtotal        Decimal               @db.Decimal(10, 2)
  discount        Decimal               @db.Decimal(10, 2)
  shippingFee     Decimal               @map("shipping_fee") @db.Decimal(10, 2)
  taxAmount       Decimal               @map("tax_amount") @db.Decimal(10, 2)
  total           Decimal               @db.Decimal(10, 2)
  currency        String                @default("INR")
  paymentMethod   CheckoutPaymentMethod @map("payment_method")
  shippingAddress Json                  @map("shipping_address")
  lineItems       Json                  @map("line_items")
  confirmedAt     DateTime?             @map("confirmed_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  checkout         CheckoutSession      @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments         Payment[]
  statusHistory    OrderStatusHistory[]
  shipments        Shipment[]
  invoice          Invoice?
  returnRequests   ReturnRequest[]
  exchangeRequests ExchangeRequest[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Immutable, append-only log of order status transitions (never updated or deleted).
model OrderStatusHistory {
  id         String         @id @default(uuid())
  orderId    String         @map("order_id")
  fromStatus OrderStatus?   @map("from_status")
  toStatus   OrderStatus    @map("to_status")
  reason     String?
  actorType  OrderActorType @map("actor_type")
  actorId    String?        @map("actor_id")
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String                @id @default(uuid())
  reference         String                @unique
  checkoutId        String                @map("checkout_id")
  orderId           String?               @map("order_id")
  userId            String?               @map("user_id")
  provider          PaymentProvider
  method            CheckoutPaymentMethod
  status            PaymentStatus         @default(created)
  amount            Decimal               @db.Decimal(10, 2)
  currency          String                @default("INR")
  providerOrderId   String?               @map("provider_order_id")
  providerPaymentId String?               @map("provider_payment_id")
  failureCode       String?               @map("failure_code")
  failureMessage    String?               @map("failure_message")
  attemptCount      Int                   @default(0) @map("attempt_count")
  expiresAt         DateTime?             @map("expires_at")
  capturedAt        DateTime?             @map("captured_at")
  metadata          Json?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  checkout    CheckoutSession  @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  attempts    PaymentAttempt[]
  webhooks    PaymentWebhook[]
  refunds     RefundRequest[]
  settlements Settlement[]

  @@index([checkoutId])
  @@index([orderId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentAttempt {
  id                String        @id @default(uuid())
  paymentId         String        @map("payment_id")
  status            PaymentStatus
  providerOrderId   String?       @map("provider_order_id")
  providerPaymentId String?       @map("provider_payment_id")
  rawResponse       Json?         @map("raw_response")
  errorMessage      String?       @map("error_message")
  createdAt         DateTime      @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_attempts")
}

model PaymentWebhook {
  id             String          @id @default(uuid())
  provider       PaymentProvider
  eventId        String          @map("event_id")
  eventType      String          @map("event_type")
  paymentId      String?         @map("payment_id")
  signatureValid Boolean         @map("signature_valid")
  processed      Boolean         @default(false)
  payload        Json
  errorMessage   String?         @map("error_message")
  createdAt      DateTime        @default(now()) @map("created_at")
  processedAt    DateTime?       @map("processed_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([processed])
  @@map("payment_webhooks")
}

// ---------------------------------------------------------------------------
// Refunds + settlements (Sprint 8 refund-ready / settlement-ready closeout)
// ---------------------------------------------------------------------------

enum RefundStatus {
  pending
  processing
  completed
  failed
}

model RefundRequest {
  id               String       @id @default(uuid())
  paymentId        String       @map("payment_id")
  orderId          String       @map("order_id")
  returnRequestId  String?      @unique @map("return_request_id")
  amount           Decimal      @db.Decimal(10, 2)
  currency         String       @default("INR")
  status           RefundStatus @default(pending)
  reason           String
  providerRefundId String?      @map("provider_refund_id")
  failureMessage   String?      @map("failure_message")
  initiatedAt      DateTime     @default(now()) @map("initiated_at")
  completedAt      DateTime?    @map("completed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
  @@map("refund_requests")
}

enum SettlementStatus {
  pending
  settled
  failed
}

/// Settlement ledger: reconciles captured payments against provider payouts.
model Settlement {
  id          String           @id @default(uuid())
  paymentId   String           @map("payment_id")
  provider    PaymentProvider
  grossAmount Decimal          @map("gross_amount") @db.Decimal(10, 2)
  feeAmount   Decimal          @map("fee_amount") @db.Decimal(10, 2)
  taxOnFee    Decimal          @map("tax_on_fee") @db.Decimal(10, 2)
  netAmount   Decimal          @map("net_amount") @db.Decimal(10, 2)
  utr         String?
  status      SettlementStatus @default(pending)
  settledAt   DateTime?        @map("settled_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
  @@map("settlements")
}

// ---------------------------------------------------------------------------
// Orders: fulfillment, tracking, invoices, returns, exchanges (Sprint 9)
// ---------------------------------------------------------------------------

model Courier {
  id                  String   @id @default(uuid())
  name                String
  code                String   @unique
  trackingUrlTemplate String?  @map("tracking_url_template")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  shipments Shipment[]

  @@map("couriers")
}

enum ShipmentStatus {
  pending
  in_transit
  out_for_delivery
  delivered
  failed
  returned
}

model Shipment {
  id                  String         @id @default(uuid())
  shipmentNumber      String         @unique @map("shipment_number")
  orderId             String         @map("order_id")
  courierId           String?        @map("courier_id")
  status              ShipmentStatus @default(pending)
  trackingNumber      String?        @map("tracking_number")
  estimatedDeliveryAt DateTime?      @map("estimated_delivery_at")
  shippedAt           DateTime?      @map("shipped_at")
  deliveredAt         DateTime?      @map("delivered_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier Courier?        @relation(fields: [courierId], references: [id], onDelete: SetNull)
  items   ShipmentItem[]
  events  TrackingEvent[]

  @@index([orderId])
  @@index([status])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentItem {
  id          String   @id @default(uuid())
  shipmentId  String   @map("shipment_id")
  variantSku  String   @map("variant_sku")
  productName String   @map("product_name")
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_items")
}

model TrackingEvent {
  id          String         @id @default(uuid())
  shipmentId  String         @map("shipment_id")
  status      ShipmentStatus
  description String
  location    String?
  occurredAt  DateTime       @map("occurred_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([occurredAt])
  @@map("tracking_events")
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique @map("order_id")
  invoiceNumber String   @unique @map("invoice_number")
  subtotal      Decimal  @db.Decimal(10, 2)
  discount      Decimal  @db.Decimal(10, 2)
  shippingFee   Decimal  @map("shipping_fee") @db.Decimal(10, 2)
  taxAmount     Decimal  @map("tax_amount") @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  pdfUrl        String?  @map("pdf_url")
  issuedAt      DateTime @default(now()) @map("issued_at")
  createdAt     DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@map("invoices")
}

model ReturnReason {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  returnRequests ReturnRequest[]

  @@map("return_reasons")
}

model ExchangeReason {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  exchangeRequests ExchangeRequest[]

  @@map("exchange_reasons")
}

enum ReturnStatus {
  requested
  approved
  rejected
  item_received
  refunded
  cancelled
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String       @map("order_id")
  userId       String?      @map("user_id")
  reasonId     String       @map("reason_id")
  status       ReturnStatus @default(requested)
  items        Json
  comments     String?
  evidenceUrls String[]     @map("evidence_urls")
  refundAmount Decimal?     @map("refund_amount") @db.Decimal(10, 2)
  requestedAt  DateTime     @default(now()) @map("requested_at")
  resolvedAt   DateTime?    @map("resolved_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason ReturnReason   @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  refund RefundRequest?

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

enum ExchangeStatus {
  requested
  approved
  rejected
  item_received
  exchanged
  cancelled
}

model ExchangeRequest {
  id            String         @id @default(uuid())
  orderId       String         @map("order_id")
  userId        String?        @map("user_id")
  reasonId      String         @map("reason_id")
  status        ExchangeStatus @default(requested)
  originalItems Json           @map("original_items")
  desiredItems  Json           @map("desired_items")
  comments      String?
  requestedAt   DateTime       @default(now()) @map("requested_at")
  resolvedAt    DateTime?      @map("resolved_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason ExchangeReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("exchange_requests")
}

// ---------------------------------------------------------------------------
// Inventory domain (Sprint 10)
// ---------------------------------------------------------------------------

enum StockMovementType {
  purchase_in
  sale_out
  return_in
  adjustment_in
  adjustment_out
  transfer_in
  transfer_out
  reservation
  release
}

enum StockReservationStatus {
  active
  released
  consumed
  expired
}

enum PurchaseOrderStatus {
  draft
  ordered
  partially_received
  received
  cancelled
}

model Warehouse {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String   @map("postal_code")
  country    String   @default("IN")
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  stockItems     StockItem[]
  movements      StockMovement[]
  reservations   StockReservation[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@map("warehouses")
}

/// Current on-hand/reserved snapshot per warehouse+variant. `onHand - reserved`
/// is the sellable quantity; the source of truth for history is `StockMovement`.
model StockItem {
  id                String   @id @default(uuid())
  warehouseId       String   @map("warehouse_id")
  variantSku        String   @map("variant_sku")
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0) @map("reserved")
  safetyStock       Int      @default(0) @map("safety_stock")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantSku])
  @@index([variantSku])
  @@index([onHand])
  @@map("stock_items")
}

/// Append-only ledger of every stock change. Never updated or deleted —
/// `StockItem.onHand`/`reserved` are derived caches maintained alongside it.
model StockMovement {
  id            String            @id @default(uuid())
  warehouseId   String            @map("warehouse_id")
  variantSku    String            @map("variant_sku")
  type          StockMovementType
  /// Always positive; `type` determines the direction applied to `StockItem`.
  quantity      Int
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  note          String?
  actorType     OrderActorType    @default(system) @map("actor_type")
  actorId       String?           @map("actor_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId, variantSku])
  @@index([variantSku])
  @@index([createdAt])
  @@map("stock_movements")
}

/// Short-lived hold on stock while a cart/checkout is in progress. Released
/// automatically on expiry by a worker job, or consumed when the order confirms.
model StockReservation {
  id          String                 @id @default(uuid())
  warehouseId String                 @map("warehouse_id")
  variantSku  String                 @map("variant_sku")
  quantity    Int
  cartId      String?                @map("cart_id")
  checkoutId  String?                @map("checkout_id")
  status      StockReservationStatus @default(active)
  expiresAt   DateTime               @map("expires_at")
  releasedAt  DateTime?              @map("released_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([variantSku])
  @@index([cartId])
  @@map("stock_reservations")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique @map("po_number")
  supplierId  String              @map("supplier_id")
  warehouseId String              @map("warehouse_id")
  status      PurchaseOrderStatus @default(draft)
  expectedAt  DateTime?           @map("expected_at")
  note        String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]

  @@index([status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String  @map("purchase_order_id")
  variantSku       String  @map("variant_sku")
  quantityOrdered  Int     @map("quantity_ordered")
  quantityReceived Int     @default(0) @map("quantity_received")
  unitCost         Decimal @map("unit_cost") @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([variantSku])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Pricing domain (Sprint 10)
// ---------------------------------------------------------------------------

model PriceList {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  currency  String   @default("INR")
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  prices ProductPrice[]

  @@map("price_lists")
}

/// The pricing source of truth per price-list+variant. Superseches
/// `ProductVariant.price` for storefront display once a row exists;
/// `ProductVariant.price`/`compareAtPrice` remain the catalog-authoring
/// fallback for variants with no explicit `ProductPrice` row yet.
model ProductPrice {
  id           String    @id @default(uuid())
  priceListId  String    @map("price_list_id")
  variantSku   String    @map("variant_sku")
  mrp          Decimal   @db.Decimal(10, 2)
  sellingPrice Decimal   @map("selling_price") @db.Decimal(10, 2)
  salePrice    Decimal?  @map("sale_price") @db.Decimal(10, 2)
  saleStartsAt DateTime? @map("sale_starts_at")
  saleEndsAt   DateTime? @map("sale_ends_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  history   PriceHistory[]

  @@unique([priceListId, variantSku])
  @@index([variantSku])
  @@map("product_prices")
}

/// Append-only. One row per price change, written by PricingService whenever
/// mrp/sellingPrice change. Never updated or deleted.
model PriceHistory {
  id              String   @id @default(uuid())
  productPriceId  String   @map("product_price_id")
  variantSku      String   @map("variant_sku")
  oldMrp          Decimal? @map("old_mrp") @db.Decimal(10, 2)
  newMrp          Decimal  @map("new_mrp") @db.Decimal(10, 2)
  oldSellingPrice Decimal? @map("old_selling_price") @db.Decimal(10, 2)
  newSellingPrice Decimal  @map("new_selling_price") @db.Decimal(10, 2)
  reason          String?
  changedBy       String?  @map("changed_by")
  createdAt       DateTime @default(now()) @map("created_at")

  productPrice ProductPrice @relation(fields: [productPriceId], references: [id], onDelete: Cascade)

  @@index([variantSku])
  @@index([createdAt])
  @@map("price_history")
}

// ---------------------------------------------------------------------------
// Promotion / campaign domain (Sprint 10)
// ---------------------------------------------------------------------------

enum CampaignType {
  sitewide
  collection
  product
}

enum CampaignStatus {
  scheduled
  active
  ended
  cancelled
}

/// A scheduled, discount-bearing promotion (flash sale, seasonal sale) distinct
/// from a one-off `Coupon` code — activation/expiry is time-driven, not
/// code-redemption-driven. A Sprint 11 CMS landing page may reference a
/// Campaign's `slug` to render "shop the sale" content without duplicating
/// the discount rule itself.
model Campaign {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  type          CampaignType
  status        CampaignStatus @default(scheduled)
  discountType  CouponType?    @map("discount_type")
  discountValue Decimal?       @map("discount_value") @db.Decimal(10, 2)
  startsAt      DateTime       @map("starts_at")
  endsAt        DateTime       @map("ends_at")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  products    CampaignProduct[]
  collections CampaignCollection[]

  @@index([status])
  @@index([startsAt, endsAt])
  @@map("campaigns")
}

model CampaignProduct {
  campaignId String @map("campaign_id")
  variantSku String @map("variant_sku")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, variantSku])
  @@map("campaign_products")
}

model CampaignCollection {
  campaignId   String @map("campaign_id")
  collectionId String @map("collection_id")

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([campaignId, collectionId])
  @@map("campaign_collections")
}

// ---------------------------------------------------------------------------
// CMS domain (Sprint 11) — fixed content-type templates, not a freeform
// block/drag-drop builder. Each `PageType` has its own expected `fields` JSON
// shape, documented in the CMS authoring guide, and validated by a per-type
// DTO/schema in the API layer (Prisma stores it as `Json` since the shape
// varies by type).
// ---------------------------------------------------------------------------

enum ContentStatus {
  draft
  scheduled
  published
  archived
}

enum PageType {
  landing
  policy
  faq
  homepage
  campaign
}

model Page {
  id              String        @id @default(uuid())
  type            PageType
  slug            String        @unique
  title           String
  status          ContentStatus @default(draft)
  /// Structured content for this page's fixed template — shape depends on `type`.
  fields          Json
  seoTitle        String?       @map("seo_title")
  seoDescription  String?       @map("seo_description")
  seoCanonicalUrl String?       @map("seo_canonical_url")
  seoOgImage      String?       @map("seo_og_image")
  scheduledAt     DateTime?     @map("scheduled_at")
  publishedAt     DateTime?     @map("published_at")
  archivedAt      DateTime?     @map("archived_at")
  createdBy       String?       @map("created_by")
  updatedBy       String?       @map("updated_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  versions PageVersion[]

  @@index([type])
  @@index([status])
  @@index([slug])
  @@map("pages")
}

/// Append-only snapshot taken every time a page is published — powers admin
/// version history / rollback. Never updated or deleted.
model PageVersion {
  id          String   @id @default(uuid())
  pageId      String   @map("page_id")
  title       String
  fields      Json
  seoSnapshot Json     @map("seo_snapshot")
  publishedBy String?  @map("published_by")
  createdAt   DateTime @default(now()) @map("created_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("page_versions")
}

enum BannerPlacement {
  homepage_hero
  homepage_strip
  category_top
  cart_strip
}

model Banner {
  id             String          @id @default(uuid())
  title          String
  imageUrl       String          @map("image_url")
  mobileImageUrl String?         @map("mobile_image_url")
  linkUrl        String?         @map("link_url")
  altText        String?         @map("alt_text")
  placement      BannerPlacement
  status         ContentStatus   @default(draft)
  sortOrder      Int             @default(0) @map("sort_order")
  startsAt       DateTime?       @map("starts_at")
  endsAt         DateTime?       @map("ends_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([placement, status])
  @@index([sortOrder])
  @@map("banners")
}

model BlogCategory {
  id   String @id @default(uuid())
  name String
  slug String @unique

  posts BlogPostCategory[]

  @@map("blog_categories")
}

model BlogTag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPost {
  id                 String        @id @default(uuid())
  slug               String        @unique
  title              String
  excerpt            String?
  coverImageUrl      String?       @map("cover_image_url")
  contentHtml        String        @map("content_html")
  authorName         String        @map("author_name")
  status             ContentStatus @default(draft)
  scheduledAt        DateTime?     @map("scheduled_at")
  publishedAt        DateTime?     @map("published_at")
  seoTitle           String?       @map("seo_title")
  seoDescription     String?       @map("seo_description")
  seoCanonicalUrl    String?       @map("seo_canonical_url")
  seoOgImage         String?       @map("seo_og_image")
  /// SKUs to show as "related products" for internal-linking/SEO purposes.
  relatedProductSkus String[]      @default([]) @map("related_product_skus")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  categories BlogPostCategory[]
  tags       BlogPostTag[]

  @@index([status])
  @@index([slug])
  @@map("blog_posts")
}

model BlogPostCategory {
  blogPostId String @map("blog_post_id")
  categoryId String @map("category_id")

  blogPost BlogPost     @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([blogPostId, categoryId])
  @@map("blog_post_categories")
}

model BlogPostTag {
  blogPostId String @map("blog_post_id")
  tagId      String @map("tag_id")

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag      BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
  @@map("blog_post_tags")
}

model Menu {
  id   String @id @default(uuid())
  code String @unique
  name String

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id            String   @id @default(uuid())
  menuId        String   @map("menu_id")
  parentId      String?  @map("parent_id")
  label         String
  url           String
  sortOrder     Int      @default(0) @map("sort_order")
  opensInNewTab Boolean  @default(false) @map("opens_in_new_tab")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuItemTree")

  @@index([menuId])
  @@index([parentId])
  @@map("menu_items")
}

// ---------------------------------------------------------------------------
// Marketing foundation placeholders (Sprint 11) — deliberately minimal.
// These exist so referral/gift-card/loyalty features have a schema and an
// admin view to build on, per the Sprint 11 plan's "foundation hooks... without
// full advanced program rollout." No earn/redeem/reward rule engine yet.
// ---------------------------------------------------------------------------

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

model GiftCard {
  id           String    @id @default(uuid())
  code         String    @unique
  initialValue Decimal   @map("initial_value") @db.Decimal(10, 2)
  balance      Decimal   @db.Decimal(10, 2)
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("gift_cards")
}

model LoyaltyAccount {
  userId        String   @id @map("user_id")
  pointsBalance Int      @default(0) @map("points_balance")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("loyalty_accounts")
}

// ---------------------------------------------------------------------------
// Admin operations domain (Sprint 12)
// ---------------------------------------------------------------------------

model CustomerSupportNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  customer User @relation("CustomerNotes", fields: [userId], references: [id], onDelete: Cascade)
  author   User @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([authorId])
  @@map("customer_support_notes")
}

enum ReportKind {
  sales
  inventory
  taxes
  customer_retention
  product_performance
  category_performance
  search
  coupons
  campaigns
}

model ReportDefinition {
  id            String     @id @default(uuid())
  slug          String     @unique
  name          String
  kind          ReportKind
  description   String?
  defaultParams Json       @default("{}") @map("default_params")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  exportJobs ExportJob[]

  @@index([kind])
  @@map("report_definitions")
}

enum ExportJobStatus {
  queued
  running
  completed
  failed
}

model ExportJob {
  id            String          @id @default(uuid())
  reportId      String          @map("report_id")
  requestedById String          @map("requested_by_id")
  status        ExportJobStatus @default(queued)
  format        String          @default("csv")
  params        Json            @default("{}")
  filePath      String?         @map("file_path")
  errorMessage  String?         @map("error_message")
  rowCount      Int?            @map("row_count")
  createdAt     DateTime        @default(now()) @map("created_at")
  startedAt     DateTime?       @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  expiresAt     DateTime?       @map("expires_at")

  report      ReportDefinition @relation(fields: [reportId], references: [id], onDelete: Restrict)
  requestedBy User             @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([requestedById])
  @@index([reportId])
  @@map("export_jobs")
}

model SavedView {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  entity    String
  name      String
  filters   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entity])
  @@map("saved_views")
}

model ScheduledJobRun {
  id         String    @id @default(uuid())
  jobKey     String    @map("job_key")
  status     String
  message    String?
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([jobKey, startedAt])
  @@map("scheduled_job_runs")
}

// ---------------------------------------------------------------------------
// Notifications domain (Sprint 13)
// WhatsApp / push / in-app are channel enum values for later adapters only.
// Queue state lives in BullMQ; DeliveryLog is the durable support record.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  email
  sms
  whatsapp
  push
  in_app
}

enum NotificationCategory {
  transactional
  marketing
  operational
}

enum TemplateStatus {
  draft
  published
  archived
}

enum DeliveryStatus {
  queued
  sending
  sent
  failed
  skipped
}

model NotificationTemplate {
  id                 String                 @id @default(uuid())
  key                String                 @unique
  name               String
  description        String?
  channel            NotificationChannel
  category           NotificationCategory
  status             TemplateStatus         @default(draft)
  requiredVariables  String[]               @default([]) @map("required_variables")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  versions NotificationTemplateVersion[]

  @@index([channel, status])
  @@index([category])
  @@map("notification_templates")
}

model NotificationTemplateVersion {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  version    Int
  subject    String?
  body       String
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId])
  @@map("notification_template_versions")
}

model NotificationPreference {
  userId              String    @id @map("user_id")
  emailTransactional  Boolean   @default(true) @map("email_transactional")
  emailMarketing      Boolean   @default(false) @map("email_marketing")
  smsTransactional    Boolean   @default(true) @map("sms_transactional")
  smsMarketing        Boolean   @default(false) @map("sms_marketing")
  unsubscribedAt      DateTime? @map("unsubscribed_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model DeliveryLog {
  id                String                 @id @default(uuid())
  userId            String?                @map("user_id")
  templateKey       String                 @map("template_key")
  channel           NotificationChannel
  category          NotificationCategory
  destination       String
  status            DeliveryStatus         @default(queued)
  eventType         String                 @map("event_type")
  providerMessageId String?                @map("provider_message_id")
  errorMessage      String?                @map("error_message")
  attempt           Int                    @default(0)
  payloadPreview    Json?                  @map("payload_preview")
  createdAt         DateTime               @default(now()) @map("created_at")
  sentAt            DateTime?              @map("sent_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destination, createdAt])
  @@index([templateKey, status])
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([channel, status])
  @@index([status, createdAt])
  @@map("delivery_logs")
}

// ---------------------------------------------------------------------------
// Analytics domain (Sprint 14)
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id            String   @id @default(uuid())
  clientEventId String   @unique @map("client_event_id")
  name          String
  sessionId     String   @map("session_id")
  userId        String?  @map("user_id")
  source        String   @default("client")
  path          String?
  properties    Json     @default("{}")
  occurredAt    DateTime @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@map("analytics_events")
}

model AnalyticsDailyAggregate {
  id             String   @id @default(uuid())
  day            DateTime @db.Date
  metric         String
  dimension      String   @default("_")
  count          Int
  uniqueSessions Int      @default(0) @map("unique_sessions")

  @@unique([day, metric, dimension])
  @@index([metric, day])
  @@map("analytics_daily_aggregates")
}

// ---------------------------------------------------------------------------
// Recommendations / personalization (Sprint 16)
// ---------------------------------------------------------------------------

model RecommendationSlotConfig {
  id                   String   @id @default(uuid())
  slot                 String   @unique
  title                String
  strategy             String
  isEnabled            Boolean  @default(true) @map("is_enabled")
  fallbackProductSlugs String[] @map("fallback_product_slugs")
  limit                Int      @default(8)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("recommendation_slot_configs")
}

/// Category/product affinities for logged-in shoppers. No email, phone, or
/// payment data — only catalog slugs and integer scores from recently viewed.
model PersonalizationProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  categoryAffinities Json     @default("[]") @map("category_affinities")
  productAffinities  Json     @default("[]") @map("product_affinities")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("personalization_profiles")
}
