// Sprint 0 baseline schema: identity, platform, and audit domains only.
// Catalog, inventory, cart, checkout, orders, payments, etc. are added in
// their respective sprints per documents/sprint-planning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity domain
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
  pending_verification
}

model User {
  id            String     @id @default(uuid())
  email         String?    @unique
  phone         String?    @unique
  displayName   String?    @map("display_name")
  passwordHash  String?    @map("password_hash")
  status        UserStatus @default(pending_verification)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  auditLogs     AuditLog[]
  profile       CustomerProfile?
  addresses     Address[]
  reviews       ProductReview[]
  wishlistItems WishlistItem[]
  recentlyViewed RecentlyViewed[]
  carts         Cart[]
  checkoutSessions CheckoutSession[]
  orders        Order[]
  payments      Payment[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  key       String           @unique
  description String?
  createdAt DateTime         @default(now()) @map("created_at")

  roles     RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum OtpChannel {
  email
  sms
}

model OtpChallenge {
  id          String     @id @default(uuid())
  channel     OtpChannel
  destination String
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  consumedAt  DateTime?  @map("consumed_at")
  expiresAt   DateTime   @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([destination, channel])
  @@map("otp_challenges")
}

enum OAuthProvider {
  google
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CustomerProfile {
  userId      String   @id @map("user_id")
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Address {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  label      String?
  fullName   String   @map("full_name")
  phone      String
  line1      String   @map("line1")
  line2      String?  @map("line2")
  city       String
  state      String
  postalCode String   @map("postal_code")
  country    String   @default("IN")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Platform domain
// ---------------------------------------------------------------------------

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  isEnabled   Boolean  @default(false) @map("is_enabled")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Audit domain
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog domain (Sprint 2)
// ---------------------------------------------------------------------------

enum ProductStatus {
  draft
  review
  published
  archived
}

enum MediaType {
  image
  video
}

enum AttributeType {
  select
  text
  number
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  ancestors   CategoryClosure[] @relation("Descendant")
  descendants CategoryClosure[] @relation("Ancestor")
  products    ProductCategory[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model CategoryClosure {
  ancestorId   String @map("ancestor_id")
  descendantId String @map("descendant_id")
  depth        Int

  ancestor   Category @relation("Ancestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Category @relation("Descendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("category_closure")
}

model AttributeDefinition {
  id        String        @id @default(uuid())
  key       String        @unique
  name      String
  type      AttributeType @default(select)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")

  values AttributeValue[]

  @@map("attribute_definitions")
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String @map("attribute_id")
  value       String
  slug        String
  sortOrder   Int    @default(0) @map("sort_order")

  attribute      AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantOptions VariantOption[]

  @@unique([attributeId, slug])
  @@map("attribute_values")
}

model Tag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  products ProductTag[]

  @@map("tags")
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products ProductCollection[]

  @@index([slug])
  @@index([isActive])
  @@map("collections")
}

model Product {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  description    String?
  brand          String?
  status         ProductStatus @default(draft)
  basePrice      Decimal?      @map("base_price") @db.Decimal(10, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(10, 2)
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  variants    ProductVariant[]
  media       ProductMedia[]
  seo         ProductSeo?
  categories  ProductCategory[]
  collections ProductCollection[]
  tags        ProductTag[]
  reviews     ProductReview[]

  @@index([status])
  @@index([slug])
  @@index([updatedAt])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  sku            String   @unique
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options VariantOption[]

  @@index([productId])
  @@map("product_variants")
}

model VariantOption {
  variantId        String @map("variant_id")
  attributeValueId String @map("attribute_value_id")

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@map("variant_options")
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  url       String
  altText   String?   @map("alt_text")
  type      MediaType @default(image)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductSeo {
  productId       String  @id @map("product_id")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  metaKeywords    String? @map("meta_keywords")
  canonicalUrl    String? @map("canonical_url")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_seo")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductCollection {
  productId    String @map("product_id")
  collectionId String @map("collection_id")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model ProductTag {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// ---------------------------------------------------------------------------
// Storefront / CMS domain (Sprint 3)
// ---------------------------------------------------------------------------

enum NavigationLocation {
  header
  footer_shop
  footer_support
  footer_legal
}

model AnnouncementBar {
  id        String   @id @default(uuid())
  message   String
  linkUrl   String?  @map("link_url")
  linkLabel String?  @map("link_label")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("announcement_bars")
}

model HomepageBlock {
  id        String   @id @default(uuid())
  key       String   @unique
  type      String
  title     String?
  content   Json
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("homepage_blocks")
}

model NavigationItem {
  id        String             @id @default(uuid())
  label     String
  href      String
  parentId  String?            @map("parent_id")
  location  NavigationLocation
  sortOrder Int                @default(0) @map("sort_order")
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at")

  parent   NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("NavTree")

  @@index([location, isActive, sortOrder])
  @@map("navigation_items")
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletter_subscribers")
}

model TrendingSearch {
  id        String   @id @default(uuid())
  term      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")

  @@index([isActive, sortOrder])
  @@map("trending_searches")
}

// ---------------------------------------------------------------------------
// Discovery domain (Sprint 4)
// ---------------------------------------------------------------------------

model SearchLog {
  id          String   @id @default(uuid())
  query       String
  resultCount Int      @map("result_count")
  filters     Json?
  source      String   @default("search")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([query])
  @@index([createdAt])
  @@map("search_logs")
}

// ---------------------------------------------------------------------------
// Product detail domain (Sprint 5)
// ---------------------------------------------------------------------------

enum ReviewStatus {
  pending
  published
  rejected
}

model ProductReview {
  id                 String       @id @default(uuid())
  productId          String       @map("product_id")
  userId             String?      @map("user_id")
  rating             Int
  title              String?
  body               String?
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  status             ReviewStatus @default(published)
  createdAt          DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([rating])
  @@map("product_reviews")
}

model WishlistItem {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  sessionId   String?  @map("session_id")
  productSlug String   @map("product_slug")
  variantSku  String?  @map("variant_sku")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@unique([userId, productSlug])
  @@unique([sessionId, productSlug])
  @@map("wishlist_items")
}

model RecentlyViewed {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  sessionId   String?  @map("session_id")
  productSlug String   @map("product_slug")
  viewedAt    DateTime @default(now()) @map("viewed_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
  @@map("recently_viewed")
}

// ---------------------------------------------------------------------------
// Cart domain (Sprint 6)
// ---------------------------------------------------------------------------

enum CouponType {
  percent
  fixed
  free_shipping
}

model Coupon {
  id           String     @id @default(uuid())
  code         String     @unique
  type         CouponType
  value        Decimal    @db.Decimal(10, 2)
  minCartValue Decimal?   @map("min_cart_value") @db.Decimal(10, 2)
  maxUses      Int?       @map("max_uses")
  usedCount    Int        @default(0) @map("used_count")
  expiresAt    DateTime?  @map("expires_at")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("coupons")
}

model Cart {
  id        String    @id @default(uuid())
  userId    String?   @unique @map("user_id")
  sessionId String?   @unique @map("session_id")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   CartItem[]
  coupons CartCoupon[]
  checkouts CheckoutSession[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String   @map("cart_id")
  productSlug   String   @map("product_slug")
  variantSku    String   @map("variant_sku")
  quantity      Int      @default(1)
  savedForLater Boolean  @default(false) @map("saved_for_later")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantSku, savedForLater])
  @@index([cartId])
  @@map("cart_items")
}

model CartCoupon {
  cartId         String  @map("cart_id")
  code           String
  discountAmount Decimal @map("discount_amount") @db.Decimal(10, 2)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@id([cartId, code])
  @@map("cart_coupons")
}

// ---------------------------------------------------------------------------
// Checkout domain (Sprint 7)
// ---------------------------------------------------------------------------

enum CheckoutStatus {
  draft
  address_selected
  shipping_selected
  payment_selected
  reviewed
  order_prepared
  expired
  cancelled
}

enum CheckoutPaymentMethod {
  razorpay
  cod
}

model CheckoutSession {
  id                String               @id @default(uuid())
  cartId            String               @map("cart_id")
  userId            String?              @map("user_id")
  sessionId         String?              @map("session_id")
  status            CheckoutStatus       @default(draft)
  subtotal          Decimal              @db.Decimal(10, 2)
  discount          Decimal              @db.Decimal(10, 2)
  shippingFee       Decimal              @map("shipping_fee") @db.Decimal(10, 2)
  taxAmount         Decimal              @map("tax_amount") @db.Decimal(10, 2)
  total             Decimal              @db.Decimal(10, 2)
  addressId         String?              @map("address_id")
  guestAddress      Json?                @map("guest_address")
  shippingMethodCode String?             @map("shipping_method_code")
  shippingLabel     String?              @map("shipping_label")
  estimatedDaysMin  Int?                 @map("estimated_days_min")
  estimatedDaysMax  Int?                 @map("estimated_days_max")
  paymentMethod     CheckoutPaymentMethod? @map("payment_method")
  lineItemsSnapshot Json                 @map("line_items_snapshot")
  couponsSnapshot   Json                 @map("coupons_snapshot")
  reviewValidAt     DateTime?            @map("review_valid_at")
  preparedOrderRef  String?              @unique @map("prepared_order_ref")
  expiresAt         DateTime             @map("expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  cart            Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  idempotencyKeys CheckoutIdempotency[]
  payments        Payment[]
  order           Order?

  @@index([userId])
  @@index([sessionId])
  @@index([cartId])
  @@index([status])
  @@index([expiresAt])
  @@map("checkout_sessions")
}

model CheckoutIdempotency {
  id             String   @id @default(uuid())
  checkoutId     String   @map("checkout_id")
  idempotencyKey String   @map("idempotency_key")
  response       Json
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  checkout CheckoutSession @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@unique([checkoutId, idempotencyKey])
  @@index([expiresAt])
  @@map("checkout_idempotency")
}

model ShippingMethod {
  id               String   @id @default(uuid())
  code             String   @unique
  label            String
  baseFee          Decimal  @map("base_fee") @db.Decimal(10, 2)
  estimatedDaysMin Int      @map("estimated_days_min")
  estimatedDaysMax Int      @map("estimated_days_max")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  zones ShippingZone[]

  @@map("shipping_methods")
}

model ShippingZone {
  id               String   @id @default(uuid())
  name             String
  pincodePrefixes  String[] @map("pincode_prefixes")
  shippingMethodId String   @map("shipping_method_id")
  feeOverride      Decimal? @map("fee_override") @db.Decimal(10, 2)
  isServiceable    Boolean  @default(true) @map("is_serviceable")
  createdAt        DateTime @default(now()) @map("created_at")

  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  @@index([shippingMethodId])
  @@map("shipping_zones")
}

model TaxRule {
  id        String   @id @default(uuid())
  name      String
  rate      Decimal  @db.Decimal(5, 4)
  appliesTo String   @default("all") @map("applies_to")
  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tax_rules")
}

// ---------------------------------------------------------------------------
// Payments + minimal Order (Sprint 8; Orders expanded in Sprint 9)
// ---------------------------------------------------------------------------

enum OrderStatus {
  pending_payment
  confirmed
  cancelled
  failed
}

enum PaymentStatus {
  created
  pending
  authorized
  captured
  failed
  cancelled
  refunded
}

enum PaymentProvider {
  razorpay
  cod
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique @map("order_number")
  checkoutId       String      @unique @map("checkout_id")
  userId           String?     @map("user_id")
  sessionId        String?     @map("session_id")
  status           OrderStatus @default(pending_payment)
  subtotal         Decimal     @db.Decimal(10, 2)
  discount         Decimal     @db.Decimal(10, 2)
  shippingFee      Decimal     @map("shipping_fee") @db.Decimal(10, 2)
  taxAmount        Decimal     @map("tax_amount") @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  currency         String      @default("INR")
  paymentMethod    CheckoutPaymentMethod @map("payment_method")
  shippingAddress  Json        @map("shipping_address")
  lineItems        Json        @map("line_items")
  confirmedAt      DateTime?   @map("confirmed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  checkout CheckoutSession @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Payment {
  id               String          @id @default(uuid())
  reference        String          @unique
  checkoutId       String          @map("checkout_id")
  orderId          String?         @map("order_id")
  userId           String?         @map("user_id")
  provider         PaymentProvider
  method           CheckoutPaymentMethod
  status           PaymentStatus   @default(created)
  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("INR")
  providerOrderId  String?         @map("provider_order_id")
  providerPaymentId String?        @map("provider_payment_id")
  failureCode      String?         @map("failure_code")
  failureMessage   String?         @map("failure_message")
  attemptCount     Int             @default(0) @map("attempt_count")
  expiresAt        DateTime?       @map("expires_at")
  capturedAt       DateTime?       @map("captured_at")
  metadata         Json?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  checkout CheckoutSession  @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  attempts PaymentAttempt[]
  webhooks PaymentWebhook[]

  @@index([checkoutId])
  @@index([orderId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentAttempt {
  id                String        @id @default(uuid())
  paymentId         String        @map("payment_id")
  status            PaymentStatus
  providerOrderId   String?       @map("provider_order_id")
  providerPaymentId String?       @map("provider_payment_id")
  rawResponse       Json?         @map("raw_response")
  errorMessage      String?       @map("error_message")
  createdAt         DateTime      @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_attempts")
}

model PaymentWebhook {
  id              String   @id @default(uuid())
  provider        PaymentProvider
  eventId         String   @map("event_id")
  eventType       String   @map("event_type")
  paymentId       String?  @map("payment_id")
  signatureValid  Boolean  @map("signature_valid")
  processed       Boolean  @default(false)
  payload         Json
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")
  processedAt     DateTime? @map("processed_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([processed])
  @@map("payment_webhooks")
}
