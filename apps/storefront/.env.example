# Browser-visible values only. Never prefix secrets (JWT, CMS preview,
# Razorpay key secret, SMTP, database) with NEXT_PUBLIC_ — Next inlines
# those into the client bundle.
# Browser calls same-origin /api/v1 (Next.js rewrite → Nest). Avoids CORS.
NEXT_PUBLIC_API_URL=/api/v1
# Server-side / RSC direct Nest URL (not exposed to the browser)
API_INTERNAL_URL=http://localhost:4000/api/v1
# next.config.mjs rewrite target
API_PROXY_TARGET=http://localhost:4000
# Canonical origin for sitemap, robots, and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Client analytics debug (also localStorage ecom_analytics_debug=1)
NEXT_PUBLIC_ANALYTICS_DEBUG=false
# Set true in production behind TLS to 308-redirect HTTP → HTTPS
FORCE_HTTPS=false

