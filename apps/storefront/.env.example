# Browser calls same-origin /api/v1 (Next.js rewrite → Nest). Avoids CORS.
NEXT_PUBLIC_API_URL=/api/v1
# Server-side / RSC direct Nest URL
API_INTERNAL_URL=http://localhost:4000/api/v1
# next.config.mjs rewrite target
API_PROXY_TARGET=http://localhost:4000
# Canonical origin for sitemap, robots, and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Client analytics debug (also localStorage ecom_analytics_debug=1)
NEXT_PUBLIC_ANALYTICS_DEBUG=false

